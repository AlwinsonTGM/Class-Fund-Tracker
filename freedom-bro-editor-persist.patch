+/** List PNG cutout files already saved for a map under public/maps/<mapId>/layers/. */
+export async function listLayerFiles(mapId: string): Promise<LayerFileRef[]> {
+  const res = await fetch(`/api/layers?mapId=${encodeURIComponent(mapId)}`);
+  if (!res.ok) {
+    let message = `Layer API GET failed (${res.status})`;
+    try {
+      const data = (await res.json()) as { error?: string };
+      if (data.error) message = data.error;
+    } catch {
+      /* keep default message */
+    }
+    throw new Error(message);
+  }
+  const data = (await res.json()) as { layers: LayerFileRef[] };
+  return data.layers || [];
+}
