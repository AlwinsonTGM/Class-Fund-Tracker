+export async function GET(req: NextRequest) {
+  try {
+    const mapId = req.nextUrl.searchParams.get('mapId');
+    if (!mapId) {
+      return NextResponse.json({ error: 'mapId query param is required' }, { status: 400 });
+    }
+    const dir = layerDir(mapId);
+    let files: string[] = [];
+    try {
+      files = (await fs.readdir(dir)).filter((f) => f.endsWith('.png'));
+    } catch {
+      // Directory does not exist yet — no saved layers.
+      files = [];
+    }
+    files.sort();
+    return NextResponse.json({
+      layers: files.map((f) => ({
+        path: `/maps/${mapId}/layers/${f}`,
+        name: f.replace(/\.png$/, ''),
+      })),
+    });
+  } catch (err) {
+    console.error('Layer list failed:', err);
+    return NextResponse.json({ error: err instanceof Error ? err.message : 'List failed' }, { status: 500 });
+  }
+}
